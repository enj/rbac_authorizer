package validation

/*
#include <stdlib.h>
#include <string.h>

// The preamble is C source, not Go, and mentions k8s.io/kubernetes/pkg on
// purpose: nothing in here may be rewritten.
static int soapbox_probe(const char *name) {
	return name != NULL && strlen(name) > 0;
}
*/
import "C"

import (
	"unsafe"

	"k8s.io/kubernetes/pkg/apis/rbac/v1"
)

// Probe reports whether the named rule is non empty.
func Probe(name string) bool {
	raw := C.CString(name)
	defer C.free(unsafe.Pointer(raw))
	return C.soapbox_probe(raw) != 0
}

var _ = v1.RuleAllows
