// Upstream commit: 0123456789abcdef0123456789abcdef01234567
// Imports under k8s.io/kubernetes were rewritten to monis.app/kk/rbac_authorizer/internal/kk.

package rbac

import (
	"context"
	"fmt"

	rbacv1 "k8s.io/api/rbac/v1"
	"k8s.io/apimachinery/pkg/types"
	"k8s.io/apiserver/pkg/authorization/authorizer"

	rbacv1helpers "monis.app/kk/rbac_authorizer/internal/kk/pkg/apis/rbac/v1"
	rbacregistryvalidation "monis.app/kk/rbac_authorizer/internal/kk/pkg/registry/rbac/validation"
)

// RBACAuthorizer is the authorizer that used to live in
// k8s.io/kubernetes/plugin/pkg/auth/authorizer/rbac. It satisfies
// "k8s.io/apiserver/pkg/authorization/authorizer".Authorizer.
type RBACAuthorizer struct {
	// authorizationRuleResolver resolves the rules a subject holds.
	authorizationRuleResolver rbacregistryvalidation.AuthorizationRuleResolver

	// source records where the rules came from.
	// +optional
	source string `json:"source" doc:"k8s.io/kubernetes/pkg/apis/rbac"`
}

// sourcePackage is the upstream package this authorizer was extracted from. It
// is a string, not an import, and must survive relocation untouched.
const sourcePackage = "k8s.io/kubernetes/plugin/pkg/auth/authorizer/rbac"

// New returns an authorizer backed by the given rule resolver.
func New(ruleResolver rbacregistryvalidation.AuthorizationRuleResolver) *RBACAuthorizer {
	return &RBACAuthorizer{authorizationRuleResolver: ruleResolver}
}

// Authorize reports whether the request is allowed.
func (r *RBACAuthorizer) Authorize(ctx context.Context, requestAttributes authorizer.Attributes) (authorizer.Decision, string, error) {
	rules, err := r.authorizationRuleResolver.RulesFor(ctx, requestAttributes.GetUser(), requestAttributes.GetNamespace())
	if err != nil {
		return authorizer.DecisionNoOpinion, "", fmt.Errorf("rules for %s: %w", sourcePackage, err)
	}
	for _, rule := range rules {
		if rbacv1helpers.RuleAllows(requestAttributes, &rule) {
			return authorizer.DecisionAllow, "", nil
		}
	}
	return authorizer.DecisionNoOpinion, "no rule matched", nil
}

var (
	_ authorizer.Authorizer = &RBACAuthorizer{}
	_ rbacv1.PolicyRule     = rbacv1.PolicyRule{}
	_ types.UID             = types.UID("")
)
